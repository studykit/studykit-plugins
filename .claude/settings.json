{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--script",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/doc_audit.py",
              "post-edit"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--script",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/doc_audit.py",
              "stop"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
  }
}
