{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/doc_audit.py",
            "args": ["post-edit"],
            "timeout": 10,
            "description": "Record an AGENTS.md/CLAUDE.md or plugins/*/agents/*.md file this turn wrote, for the turn-end audit dispatch. Records only; never blocks."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/doc_audit.py",
            "args": ["stop"],
            "timeout": 10,
            "description": "When the finished turn edited agent instruction files or plugin agent definitions, ask for contributor-docs-auditor / plugin-agent-doc-auditor over exactly those files."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": false,
    "plugin-dev@claude-plugins-official": true,
    "hookify@claude-plugins-official": false,
    "mcp-server-dev@claude-plugins-official": false,
    "pyright-lsp@claude-plugins-official": false
  }
}
