{
  "description": "Codex lifecycle hooks for guard. The Codex adapter records documented hook payloads rather than parsing transcripts.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --script \"${PLUGIN_ROOT}/hooks/scripts/hook_codex.py\"",
            "timeout": 10,
            "statusMessage": "Loading guard policy"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --script \"${PLUGIN_ROOT}/hooks/scripts/hook_codex.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --script \"${PLUGIN_ROOT}/hooks/scripts/hook_codex.py\"",
            "timeout": 10,
            "description": "Refuse a search rooted at `/`. MUST stay synchronous: a background hook cannot block a Codex PreToolUse call whatever JSON it returns (wiki/ref/openai-codex-pretooluse-deny-output-shape.md)."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --script \"${PLUGIN_ROOT}/hooks/scripts/hook_codex.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --script \"${PLUGIN_ROOT}/hooks/scripts/hook_codex.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
