{
  "description": "Codex lifecycle hooks for guard. The adapter records documented turn payloads and accumulates edited files for explicit audit checkpoints without parsing transcripts.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --script \"${PLUGIN_ROOT}/hooks/scripts/hook_codex.py\"",
            "timeout": 10,
            "statusMessage": "Loading guard policy"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --script \"${PLUGIN_ROOT}/hooks/scripts/hook_codex.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --script \"${PLUGIN_ROOT}/hooks/scripts/hook_codex.py\"",
            "timeout": 10,
            "description": "Refuse a search rooted at `/`. MUST stay synchronous: a background hook cannot block a Codex PreToolUse call whatever JSON it returns (wiki/ref/openai-codex-pretooluse-deny-output-shape.md)."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --script \"${PLUGIN_ROOT}/hooks/scripts/hook_codex.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --script \"${PLUGIN_ROOT}/hooks/scripts/hook_codex.py\"",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "review",
            "tool": "confirm_file_review",
            "input": {
              "cwd": "${cwd}",
              "session_id": "${session_id}",
              "stop_hook_active": "${stop_hook_active}",
              "transcript_path": "${transcript_path}",
              "turn_id": "${turn_id}"
            },
            "timeout": 360,
            "statusMessage": "Checking Guard file-review consent"
          }
        ]
      }
    ]
  }
}
