{
  "audit-plan": "on",
  "turn_review": {
    "kind": "agent",
    "name": "reviewer"
  },
  "plan_review": {
    "kind": "agent",
    "name": "reviewer"
  },
  "answer_review": {
    "kind": "skill",
    "name": "review-answer"
  },
  "file_review_rules": [
    {
      "glob": "src/**",
      "action": {
        "kind": "agent",
        "name": "reviewer"
      },
      "on_stop": "ask"
    },
    {
      "glob": "docs/**/*.md",
      "action": {
        "kind": "skill",
        "name": "review-docs"
      },
      "on_stop": "manual"
    },
    {
      "glob": "config/**/*.json",
      "action": {
        "kind": "agent",
        "name": "reviewer"
      },
      "on_stop": "ask"
    }
  ],
  "files_exclude": [
    "generated/**",
    "vendor/**"
  ]
}
