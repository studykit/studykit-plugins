{
  "audit-plan": "on",
  "plan_review": {
    "kind": "agent",
    "name": "project:plan-reviewer"
  },
  "file_review_rules": [
    {
      "glob": "**/*.py",
      "action": {
        "kind": "agent",
        "name": "guard:comment-corrector"
      }
    },
    {
      "glob": "wiki/ref/**/*.md",
      "action": {
        "kind": "agent",
        "name": "guard:ext-docs-auditor"
      }
    },
    {
      "glob": "docs/**/*.md",
      "action": {
        "kind": "agent",
        "name": "guard:doc-auditor"
      }
    },
    {
      "glob": "docs/api/**/*.md",
      "action": {
        "kind": "skill",
        "name": "project:review-api-docs"
      }
    }
  ],
  "files_exclude": [
    "docs/generated/**",
    "!docs/generated/README.md"
  ],
  "refs_dir": ""
}
