{
  "description": "guard hooks. Logic lives in `scripts/guard_hook.py`; see `dev/design.md` for the design.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/guard_hook.py\" user-prompt",
            "timeout": 120,
            "description": "Trace only — guard keeps no record of the prompt."
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "^(guard:)?claims-auditor$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/guard_hook.py\" verify claims-auditor",
            "timeout": 5,
            "description": "On demand, dispatch the claims auditor for the last completed turn."
          }
        ]
      },
      {
        "matcher": "^(guard:)?deferrals-auditor$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/guard_hook.py\" verify deferrals-auditor",
            "timeout": 5,
            "description": "On demand, dispatch the deferrals auditor for the last completed turn."
          }
        ]
      },
      {
        "matcher": "^(guard:)?clarity-auditor$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/guard_hook.py\" verify clarity-auditor",
            "timeout": 5,
            "description": "On demand, dispatch the clarity auditor for the last completed turn."
          }
        ]
      },
      {
        "matcher": "^(guard:)?korean-corrector$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/guard_hook.py\" verify korean-corrector",
            "timeout": 5,
            "description": "On demand, dispatch the Korean corrector for the last completed turn."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/guard_hook.py\" post-edit",
            "timeout": 10,
            "description": "Record a source file written this turn (for a comment-corrector recommendation), and require a file saved inside the refs dir to be listed in the refs index (AGENTS.md)."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/guard_hook.py\" stop",
            "timeout": 120,
            "description": "Mark the finished turn as the on-demand audit target, and — when any agent switch is on — ask the main agent to route the turn and dispatch the agents worth running on it."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/guard_hook.py\" session-start",
            "timeout": 5,
            "description": "Sweep guard state and turn records past the retention window, export GUARD_REFS_DIR, and state the refs rule as session context."
          }
        ]
      }
    ]
  }
}
