{
  "description": "guard hooks. Logic lives in `scripts/guard_hook.py`; see `dev/design.md` for the design.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/guard_hook.py\" user-prompt",
            "timeout": 120,
            "description": "Log the user turn and update approval-gate state (gate only)."
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "^(guard:)?audit-claims$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/guard_hook.py\" verify claims",
            "timeout": 5,
            "description": "On demand, dispatch the claims auditor for the last completed turn."
          }
        ]
      },
      {
        "matcher": "^(guard:)?audit-deferrals$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/guard_hook.py\" verify deferrals",
            "timeout": 5,
            "description": "On demand, dispatch the deferrals auditor for the last completed turn."
          }
        ]
      },
      {
        "matcher": "^(guard:)?audit-korean$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/guard_hook.py\" verify korean",
            "timeout": 5,
            "description": "On demand, dispatch the korean auditor for the last completed turn."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/guard_hook.py\" gate",
            "timeout": 10,
            "description": "Gate file-mutating tools on the approval state."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/guard_hook.py\" plan-approved",
            "timeout": 60,
            "description": "On plan approval, arm the approval gate when the plan defers no in-scope work."
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/guard_hook.py\" gate-approved",
            "timeout": 10,
            "description": "In edit_gate ask, arm the approval gate after the user approves an edit's permission prompt."
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/guard_hook.py\" refs-index",
            "timeout": 10,
            "description": "After a write inside the refs dir, require the saved file to be listed in the refs index (AGENTS.md)."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/guard_hook.py\" stop",
            "timeout": 120,
            "description": "Log the assistant turn and run the evidence judge when armed."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/guard_hook.py\" session-start",
            "timeout": 5,
            "description": "Sweep guard state and logs past the retention window, export GUARD_REFS_DIR, and state the refs rule as session context."
          }
        ]
      }
    ]
  }
}
